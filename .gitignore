# Two apps: android/ (Kotlin, Gradle) and ios/ (Swift, XcodeGen) — each has its own build ignores too.

node_modules/
android/dist/
# The leftover v1 folder name, in case a stale build dir lingers.
native/

# Signing material other than the public template keystore android/app/debug.keystore
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Editors / OS
.DS_Store
.vscode/
.idea/

# Logs
npm-debug.*
yarn-debug.*
yarn-error.*
