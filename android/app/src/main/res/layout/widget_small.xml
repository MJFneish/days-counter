<?xml version="1.0" encoding="utf-8"?>
<!-- Smallest widget (1×1, 2×1): the day count and its unit, centered.
     All four widget layouts share view ids; DaysWidgetProvider fills whichever ones exist. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_bg_ember"
  android:clipToOutline="true"
  android:padding="8dp"
  tools:targetApi="s">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
      android:id="@+id/widget_days"
      android:layout_width="match_parent"
      android:layout_height="0dp"
      android:layout_weight="1"
      android:autoSizeMaxTextSize="44sp"
      android:autoSizeMinTextSize="14sp"
      android:autoSizeTextType="uniform"
      android:gravity="center"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:textColor="@color/widget_text"
      android:textStyle="bold"
      tools:text="316" />

    <TextView
      android:id="@+id/widget_unit"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:gravity="center"
      android:maxLines="2"
      android:textColor="@color/widget_text_muted"
      android:textSize="12sp"
      tools:text="days to go" />
  </LinearLayout>
</FrameLayout>
