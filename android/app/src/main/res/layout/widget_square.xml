<?xml version="1.0" encoding="utf-8"?>
<!-- Square widget (2×2, 2×3): name, the day count, its unit, the live H:MM:SS. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_bg_ember"
  android:clipToOutline="true"
  android:gravity="center"
  android:orientation="vertical"
  android:padding="12dp"
  tools:targetApi="s">

  <TextView
    android:id="@+id/widget_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:gravity="center"
    android:maxLines="1"
    android:textColor="@color/widget_text"
    android:textSize="13sp"
    android:textStyle="bold"
    tools:text="Graduation day" />

  <TextView
    android:id="@+id/widget_days"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1"
    android:autoSizeMaxTextSize="56sp"
    android:autoSizeMinTextSize="20sp"
    android:autoSizeTextType="uniform"
    android:gravity="center"
    android:includeFontPadding="false"
    android:maxLines="1"
    android:textColor="@color/widget_text"
    android:textStyle="bold"
    tools:text="316" />

  <TextView
    android:id="@+id/widget_unit"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:gravity="center"
    android:maxLines="2"
    android:textColor="@color/widget_text_muted"
    android:textSize="12sp"
    tools:text="days to go" />

  <Chronometer
    android:id="@+id/widget_chrono"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:textColor="@color/widget_text"
    android:textDirection="ltr"
    android:textSize="17sp"
    android:textStyle="bold" />
</LinearLayout>
