<?xml version="1.0" encoding="utf-8"?>
<!-- Large widget (3×2 and up): name + date, the big day count with its unit and the live
     H:MM:SS, then the progress of the wait. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_bg_ember"
  android:clipToOutline="true"
  android:orientation="vertical"
  android:padding="16dp"
  tools:targetApi="s">

  <TextView
    android:id="@+id/widget_title"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:gravity="start"
    android:maxLines="1"
    android:textColor="@color/widget_text"
    android:textSize="16sp"
    android:textStyle="bold"
    tools:text="Graduation day" />

  <TextView
    android:id="@+id/widget_detail"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:ellipsize="end"
    android:gravity="start"
    android:maxLines="1"
    android:textColor="@color/widget_text_muted"
    android:textSize="12sp"
    tools:text="5 Sep 2027" />

  <!-- Spacer (a plain View isn't allowed in RemoteViews). -->
  <FrameLayout
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:layout_weight="1" />

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="bottom"
    android:orientation="horizontal">

    <TextView
      android:id="@+id/widget_days"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:textColor="@color/widget_text"
      android:textSize="48sp"
      android:textStyle="bold"
      tools:text="316" />

    <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="10dp"
      android:layout_weight="1"
      android:orientation="vertical">

      <TextView
        android:id="@+id/widget_unit"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="start"
        android:maxLines="2"
        android:textColor="@color/widget_text_muted"
        android:textSize="13sp"
        tools:text="days to go" />

      <Chronometer
        android:id="@+id/widget_chrono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_text"
        android:textDirection="ltr"
        android:textSize="22sp"
        android:textStyle="bold" />
    </LinearLayout>
  </LinearLayout>

  <ProgressBar
    android:id="@+id/widget_progress"
    style="@android:style/Widget.ProgressBar.Horizontal"
    android:layout_width="match_parent"
    android:layout_height="6dp"
    android:layout_marginTop="12dp"
    android:max="1000"
    android:progressDrawable="@drawable/widget_progress" />

  <TextView
    android:id="@+id/widget_percent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="4dp"
    android:ellipsize="end"
    android:gravity="start"
    android:maxLines="1"
    android:textColor="@color/widget_text_muted"
    android:textSize="11sp"
    tools:text="3% of the wait done" />
</LinearLayout>
