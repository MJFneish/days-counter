<?xml version="1.0" encoding="utf-8"?>
<!-- Wide, one row high (3×1, 4×1, 5×1): name + date on the start side, the day count + live
     H:MM:SS on the end side. Mirrors in Arabic (the provider sets the root RTL). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  android:id="@android:id/background"
  android:layout_width="match_parent"
  android:layout_height="match_parent"
  android:background="@drawable/widget_bg_ember"
  android:clipToOutline="true"
  android:gravity="center_vertical"
  android:orientation="horizontal"
  android:paddingStart="16dp"
  android:paddingTop="8dp"
  android:paddingEnd="16dp"
  android:paddingBottom="8dp"
  tools:targetApi="s">

  <LinearLayout
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:orientation="vertical">

    <TextView
      android:id="@+id/widget_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:gravity="start"
      android:maxLines="1"
      android:textColor="@color/widget_text"
      android:textSize="15sp"
      android:textStyle="bold"
      tools:text="Graduation day" />

    <TextView
      android:id="@+id/widget_detail"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:gravity="start"
      android:maxLines="1"
      android:textColor="@color/widget_text_muted"
      android:textSize="12sp"
      tools:text="5 Sep 2027" />

    <TextView
      android:id="@+id/widget_unit"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:ellipsize="end"
      android:gravity="start"
      android:maxLines="1"
      android:textColor="@color/widget_text_muted"
      android:textSize="12sp"
      tools:text="days to go" />
  </LinearLayout>

  <LinearLayout
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <TextView
      android:id="@+id/widget_days"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:includeFontPadding="false"
      android:maxLines="1"
      android:textColor="@color/widget_text"
      android:textSize="30sp"
      android:textStyle="bold"
      tools:text="316" />

    <Chronometer
      android:id="@+id/widget_chrono"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:textColor="@color/widget_text"
      android:textDirection="ltr"
      android:textSize="14sp"
      android:textStyle="bold" />
  </LinearLayout>
</LinearLayout>
